{
	"name": "@infinityfx/fluid",
	"version": "2.0.3",
	"type": "module",
	"description": "React UI library, using zero-runtime CSS-in-JS.",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/types/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/src/index.d.ts",
			"default": "./dist/index.js"
		},
		"./hooks": {
			"types": "./dist/types/src/hooks.d.ts",
			"default": "./dist/hooks.js"
		},
		"./utils": {
			"types": "./dist/types/src/utils.d.ts",
			"require": "./dist/utils.cjs",
			"import": "./dist/utils.mjs"
		},
		"./css": {
			"types": "./dist/types/src/css.d.ts",
			"default": "./dist/css.js"
		}
	},
	"typesVersions": {
		"*": {
			"hooks": [
				"./dist/types/src/hooks.d.ts"
			],
			"utils": [
				"./dist/types/src/utils.d.ts"
			],
			"css": [
				"./dist/types/src/css.d.ts"
			]
		}
	},
	"repository": "infinityfx-llc/fluid",
	"author": "InfinityFX <contact@infinity-fx.com> (https://infinityfx.dev)",
	"license": "GPL-3.0",
	"bugs": "https://github.com/infinityfx-llc/fluid/issues",
	"homepage": "https://fluid.infinityfx.dev",
	"funding": "https://ko-fi.com/infinityfx",
	"keywords": [
		"react",
		"ui",
		"components",
		"compiled",
		"zero-runtime",
		"css in js",
		"fluid ui"
	],
	"scripts": {
		"build": "rollup -c --environment NODE_ENV:production",
		"watch": "rollup -c -w --watch.onEnd=\"npx fluid compile\"",
		"demo": "npx fluid compile -d && vite e2e/app --port 5173",
		"test:e2e": "playwright test --project=\"e2e\"",
		"test:videos": "playwright test --project=\"videos\""
	},
	"bin": {
		"@infinityfx/fluid": "dist/bin/cli.js",
		"fluid": "dist/bin/cli.js"
	},
	"dependencies": {
		"glob": "^13.0.6",
		"tslib": "^2.8.1"
	},
	"peerDependencies": {
		"@infinityfx/lively": ">=5.0.0",
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0",
		"react-icons": ">=5.4.0"
	},
	"devDependencies": {
		"@ffmpeg-installer/ffmpeg": "^1.1.0",
		"@infinityfx/lively": "^5.0.0",
		"@playwright/test": "^1.50.0",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.3.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-icons": "^5.7.0",
		"rollup": "^4.62.3",
		"rollup-plugin-delete": "^3.0.2",
		"rollup-plugin-preserve-directives": "^0.4.0",
		"rollup-plugin-preserve-shebangs": "^0.2.0",
		"typescript": "^6.0.3",
		"vite": "^6.0.7"
	},
	"sideEffects": false
}
